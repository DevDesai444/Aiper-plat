{
  "name": "aiper",
  "productName": "Aiper",
  "version": "0.1.0",
  "description": "Aiper — document authoring platform",
  "main": "./out/main/index.js",
  "author": "Aiper",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "tsx tests/csp.test.ts && tsx tests/docx-fidelity.test.ts && tsx tests/document-diff.test.ts && tsx tests/ribbon-commands.test.ts && tsx tests/compliance-engine.test.ts && tsx tests/project-import.test.ts",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.2.8",
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/barlow-semi-condensed": "^5.2.8",
    "@tiptap/core": "^2.26.2",
    "@tiptap/extension-character-count": "^2.26.2",
    "@tiptap/extension-color": "^2.26.2",
    "@tiptap/extension-highlight": "^2.26.2",
    "@tiptap/extension-image": "^2.26.2",
    "@tiptap/extension-link": "^2.26.2",
    "@tiptap/extension-placeholder": "^2.26.2",
    "@tiptap/extension-subscript": "^2.26.2",
    "@tiptap/extension-superscript": "^2.26.2",
    "@tiptap/extension-table": "^2.26.2",
    "@tiptap/extension-table-cell": "^2.26.2",
    "@tiptap/extension-table-header": "^2.26.2",
    "@tiptap/extension-table-row": "^2.26.2",
    "@tiptap/extension-text-align": "^2.26.2",
    "@tiptap/extension-text-style": "^2.26.2",
    "@tiptap/extension-underline": "^2.26.2",
    "@tiptap/pm": "^2.26.2",
    "@tiptap/react": "^2.26.2",
    "@tiptap/starter-kit": "^2.26.2",
    "chokidar": "^4.0.3",
    "diff": "^5.2.2",
    "docx": "^9.5.1",
    "fast-xml-parser": "^5.3.0",
    "jsdom": "^25.0.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.544.0",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/diff": "^7.0.2",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^5.4.20"
  }
