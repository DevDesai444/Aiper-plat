# Copy to `.env` for local dev. `.env` is git-ignored via the repo-root .gitignore.
# Both keys are safe to embed in the built client bundle — VITE_SUPABASE_ANON_KEY
# is the publishable anon key, not a secret. The app calls `/api/...` on the
# same origin (Vite proxies to the Fastify server in dev; @fastify/static will
# serve the built SPA from the same origin in prod), so there is no API URL to
# configure here.

VITE_SUPABASE_URL=https://gawfzgnotbyjtkoxtbur.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_yQVSqeDgnBm97E6zN9Nqkg_MTfsc1lE
