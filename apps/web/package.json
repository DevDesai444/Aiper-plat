{
  "name": "@aiper/web",
  "version": "0.0.0",
  "private": true,
  "description": "Aiper web SPA — Vite + React 18 shell over the Fastify API",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
