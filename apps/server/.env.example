# apps/server/.env  (copy to .env for local development)

# HTTP
PORT=8787
HOST=127.0.0.1
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# JWT verification.
#
# Exactly one of the two variables below MUST be set. The server refuses to
# start otherwise, because there would be no way to verify inbound JWTs.
#
# Production: point SUPABASE_JWKS_URL at your Supabase project's JWKS endpoint.
# The server fetches keys with jose's built-in TTL cache and verifies RS256.
#
# Local dev / CI: set SUPABASE_JWT_TEST_SECRET to a long random string. The
# server verifies HS256 with that shared secret. Do NOT use this in prod.
# ---------------------------------------------------------------------------

# SUPABASE_JWKS_URL=https://<your-project>.supabase.co/auth/v1/keys
SUPABASE_JWT_TEST_SECRET=change-me-locally-any-random-string-at-least-16-chars

# ---------------------------------------------------------------------------
# Postgres (unused in PR-2; PR-3 wires the pool).
# ---------------------------------------------------------------------------
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=aiper
PGPASSWORD=aiper_dev
PGDATABASE=aiper
