# apps/server/.env  (copy to .env for local development)

# HTTP
PORT=8787
HOST=127.0.0.1
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# JWT verification.
#
# The server refuses to start unless BOTH of the following are true:
#   (a) SUPABASE_JWT_ISSUER is set (always required)
#   (b) at least one of SUPABASE_JWKS_URL or SUPABASE_JWT_TEST_SECRET is set
#
# Production: point SUPABASE_JWKS_URL at your Supabase project's JWKS
# endpoint. The server fetches keys with jose's built-in TTL cache and
# verifies RS256/ES256. SUPABASE_JWT_ISSUER pins iss to your project so a
# well-signed token from a sibling project cannot authenticate a request.
# Every verify also requires aud='authenticated' — Supabase's anon key
# (aud='anon') will not sign in a real user.
#
# Local dev / CI: set SUPABASE_JWT_TEST_SECRET to a long random string. The
# server verifies HS256 with that shared secret. Same iss + aud checks apply
# — the shared secret is not a bypass. Do NOT use HS256 in production.
#
# When both SUPABASE_JWKS_URL and SUPABASE_JWT_TEST_SECRET are set,
# SUPABASE_JWKS_URL wins — a leftover test secret in a .env cannot silently
# weaken a real deploy.
# ---------------------------------------------------------------------------

# Required. Must equal Supabase's Auth issuer for your project.
SUPABASE_JWT_ISSUER=https://<your-project-ref>.supabase.co/auth/v1

# Production JWKS. Pair with SUPABASE_JWT_ISSUER above.
# SUPABASE_JWKS_URL=https://<your-project-ref>.supabase.co/auth/v1/keys

# Local dev / CI fallback. Any string ≥ 16 characters.
SUPABASE_JWT_TEST_SECRET=change-me-locally-any-random-string-at-least-16-chars

# ---------------------------------------------------------------------------
# Postgres (unused in PR-2; PR-3 wires the pool).
# ---------------------------------------------------------------------------
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=aiper
PGPASSWORD=change-me-locally
PGDATABASE=aiper
