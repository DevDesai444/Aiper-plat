{
  "name": "@aiper/server",
  "version": "0.0.0",
  "private": true,
  "description": "Aiper server — Fastify 5, JWT auth, PostgreSQL",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@aiper/shared": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.2.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "fastify-type-provider-zod": "^4.0.2",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.23.12"
  }
}
